---
import extra from '../extra.json';
const quotes = extra.quotes;
const initials = (n) => n.split(' ').map((w) => w[0]).join('');
---
<section class="section section--tint">
  <div class="wrap stack center" style="gap:14px" data-reveal>
    <p class="eyebrow">Testimonials</p>
    <h2 class="ds-display h2">Feedback from leaders &amp; collaborators.</h2>
    <p class="lede">A glimpse into what it’s like to think, design, and grow together.</p>
  </div>
  <div class="wrap">
    <div class="tcar" data-carousel data-reveal>
      <span class="tcar__mark ds-display" aria-hidden="true">“</span>
      <div class="tcar__stage">
        {quotes.map((q, i) => (
          <figure class="tcar__slide" data-slide aria-hidden={i === 0 ? 'false' : 'true'}>
            <blockquote class="ds-display">{q.text}</blockquote>
            <figcaption><span class="tcar__avatar">{initials(q.author)}</span><b>{q.author}</b><small>{q.role}</small></figcaption>
          </figure>
        ))}
      </div>
      <div class="tcar__nav">
        <button class="ds-iconbtn" data-prev aria-label="Previous testimonial"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6" /></svg></button>
        <div class="tcar__dots">{quotes.map((_, i) => <button data-dot={i} aria-label={`Testimonial ${i + 1}`} aria-current={i === 0 ? 'true' : 'false'}></button>)}</div>
        <button class="ds-iconbtn" data-next aria-label="Next testimonial"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg></button>
      </div>
    </div>
  </div>
</section>
