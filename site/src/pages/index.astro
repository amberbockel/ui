---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import SystemCards from '../components/SystemCards.astro';
import Monogram from '../components/Monogram.astro';
import { sec, meta, img } from '../lib.js';
import extra from '../extra.json';
import posts from '../posts.json';
import { THEMES } from '../systems.js';
import config from '../site.config.js';

const hero = sec('home', 'I help organizations');
const intro = sec('home', 'A design leader');
const tiles = [
  { ...sec('home', 'Design Leadership'), image: '9I1HTKYV2KroBSPtk2oL6Nkp0.png', alt: 'Amber leading a team workshop at a whiteboard', link: ['Explore my work', '/work/'] },
  { ...sec('home', 'Mentorship'), image: 'w37o2DK6SV62hwDSwpX2tzo69g.png', alt: 'Amber standing in front of one of her paintings', link: ['Work with me', '/mentor/'] },
  { ...sec('home', 'Creative Practice'), image: 'AiWelu5gtIplutsZSeL7CgcHTtE.png', alt: 'A bright abstract painting hung in a hallway', link: ['See my art', '/art/'] },
];
const persp = sec('home', 'Perspectives');
const latest = posts.slice(0, 3);
const fmt = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout {...meta('home')} current="/" overlay>
  <section class="hero hero--aurora stage" data-stage>
    <div class="stage__in">
      <h1 class="stage__type ds-display" aria-label="Human plus AI. I help organizations design how humans and AI make decisions together.">
        <span class="stage__word" data-word style="--i:0" aria-hidden="true">Human</span>
        <span class="stage__line" aria-hidden="true"><span class="stage__plus">+</span><span class="stage__word stage__word--b" data-word style="--i:1">AI</span></span>
      </h1>
      <div class="stage__figure" data-figure>
        {THEMES.map((t) => <img class="stage__photo" data-for={t.id} src={img(t.intro.photo)} alt={t.intro.alt} width="559" height="852" loading={t.id === config.system ? 'eager' : 'lazy'} />)}
      </div>
    </div>
  </section>

  <section class="section section--flush cover">
    <a class="stage__badge" href="/about/" aria-label="About Amber">
        <svg class="badge-ring" viewBox="0 0 120 120" aria-hidden="true"><defs><path id="ring" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs>
          <text><textPath href="#ring" textLength="282">DESIGN LEADER · MENTOR · ARTIST ·</textPath></text></svg>
        <Monogram />
      </a>
    <div class="wrap stack center cover__in" data-reveal>
      <h2 class="cover__statement ds-display">I help <span class="hi">organizations</span> design how <span class="hi hi--b">humans</span> and <span class="hi">AI</span> make <span class="hi hi--b">decisions</span> <u>together</u>.</h2>
      <p class="cover__text">{intro.heading} {intro.paras[0]}</p>
      <p class="cover__text">{hero.paras[0]}</p>
      <a class="cover__btn" href="/work/">See my work</a>
    </div>
  </section>

  <section class="section section--flush">
    <div class="wrap center" data-reveal><p class="eyebrow">Where I’ve led design</p></div>
    <div class="marquee" aria-label="Places Amber has worked" data-reveal>
      <div class="marquee__track">
        {[0, 1, 2].map((r) => extra.logos.map(([name, file]) => <img src={img(file)} alt={r === 0 ? name : ''} aria-hidden={r === 0 ? undefined : 'true'} loading="lazy" />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="mosaic">
        {tiles.map((t, i) => (
          <>
            <div class={`mosaic__text ${i % 2 ? 'mosaic__text--b' : ''}`} data-reveal>
              <h2 class="ds-display h3">{t.heading}</h2>
              {t.paras.map((p) => <p>{p}</p>)}
              <a class="arrow-link" href={t.link[1]}>{t.link[0]}<span aria-hidden="true">→</span></a>
            </div>
            <a class={`mosaic__media ${i % 2 ? 'mosaic__media--b' : ''}`} href={t.link[1]} tabindex="-1" aria-hidden="true" data-reveal style="--d:.08s">
              <img src={img(t.image)} alt={t.alt} loading="lazy" />
            </a>
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap stack" style="gap:28px">
      <div class="split-head" data-reveal>
        <div class="stack" style="gap:12px">
          <h2 class="ds-display h2">{persp.heading}</h2>
          <p class="lede">{persp.paras[0]}</p>
        </div>
        <a class="arrow-link" href="/blog/">Read the latest<span aria-hidden="true">→</span></a>
      </div>
      <div class="post-grid">
        {latest.map((p, i) => (
          <a class="post-card" href={`/blog/${p.slug}/`} data-reveal style={`--d:${i * 0.08}s`}>
            <div class="post-card__media">{p.cover && <img src={p.cover} alt="" loading="lazy" />}</div>
            <div class="post-card__body"><time datetime={p.date}>{fmt(p.date)} · {p.minutes} min read</time><h3 class="ds-display">{p.title}</h3></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="gap:28px">
      <div class="split-head" data-reveal>
        <div class="stack" style="gap:12px">
          <p class="eyebrow eyebrow--accent">An experiment</p>
          <h2 class="ds-display h2">This site wears four design systems</h2>
          <p class="lede">Same pages, same words. Pick a look and the whole site changes its colour, type and shape.</p>
        </div>
        <a class="arrow-link" href="/systems/">How it works<span aria-hidden="true">→</span></a>
      </div>
      <SystemCards />
    </div>
  </section>

  <Cta />
</Layout>
