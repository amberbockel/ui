---
import Layout from '../layouts/Layout.astro';
import SystemCards from '../components/SystemCards.astro';
import Cta from '../components/Cta.astro';
import { THEMES, tokenCount } from '../systems.js';

const kebab = (k) => k.replace(/[A-Z]/g, (m) => '-' + m.toLowerCase());
const swatchKeys = ['bg', 'surface', 'surface2', 'fg', 'primary', 'accent', 't1Bg', 't2Bg'];
const fontName = (f) => f.split(',')[0].replace(/"/g, '');
const signature = {
  sunrise: 'A slow-drifting aurora behind white type, and a frosted glass card.',
  sierra: 'A soft lime and teal glow behind the hero.',
  unicorns: 'Two rotating star stickers, a hard sticker shadow on buttons, and a wavy underline for emphasis.',
  ember: 'An ember glow at the foot of the hero, and portraits in black and white until you hover.',
};
const tokens = tokenCount(THEMES[0]);
---
<Layout title="Design systems | Amber Miro Heinbockel" description="This site can change its whole design system from one switch. How it works, and what testing it showed." current="/systems/">
  <section class="hero hero--plain">
    <div class="wrap stack center">
      <p class="eyebrow eyebrow--accent" data-rise style="--i:0">Design systems</p>
      <h1 class="ds-display h1" data-rise style="--i:1">One site, four design systems</h1>
      <p class="lede" data-rise style="--i:2">This site can change its whole look from one switch in the header. Here is how that works, and what I learned by testing it.</p>
    </div>
  </section>

  <section class="section section--flush">
    <div class="wrap stack" style="gap:24px">
      <h2 class="ds-display h2" data-reveal>Pick a look</h2>
      <SystemCards />
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap stack" style="gap:32px">
      <div class="stack" style="gap:12px" data-reveal>
        <p class="eyebrow eyebrow--accent">How it works</p>
        <h2 class="ds-display h2" style="max-width:20ch">The same idea as dark mode, taken further</h2>
      </div>
      <div class="steps" data-reveal>
        <div><h3 class="ds-display">Tokens</h3><p>Each system is a list of about {tokens} named values for colour, type and shape. Every button, card and heading reads from those names and never from a fixed colour or size.</p></div>
        <div><h3 class="ds-display">One attribute</h3><p>The page carries one attribute that says which list is in use, next to the one that says light or dark. Change the attribute and everything follows.</p></div>
        <div><h3 class="ds-display">One signature</h3><p>Tokens cannot carry a system’s character on their own. So each system also gets one gesture that belongs only to it.</p></div>
      </div>
      <pre class="codeblock" data-reveal><code>&lt;html data-system="ember" data-mode="dark"&gt;

[data-system="ember"] &#123;
  --ds-bg: #0f0e0e;
  --ds-font-display: "Inter Tight";
  --ds-r-card: 0px;
&#125;</code></pre>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack" style="gap:32px">
      <div class="stack" style="gap:12px" data-reveal>
        <p class="eyebrow eyebrow--accent">What the test found</p>
        <h2 class="ds-display h2" style="max-width:22ch">I ran every page in every system, in light and dark</h2>
      </div>
      <div class="findings" data-reveal>
        <div class="stat"><b class="ds-display" data-count="56">56</b><span>page renders checked</span></div>
        <div class="stat"><b class="ds-display" data-count="0">0</b><span>layouts that broke</span></div>
        <div class="stat"><b class="ds-display" data-count="95">95</b><span>places where text was too faint, before fixes</span></div>
        <div class="stat"><b class="ds-display" data-count="0">0</b><span>left after one new token</span></div>
      </div>
      <ul class="bullets" data-reveal>
        <li>Layout survived everything, including oversized type and square corners.</li>
        <li>Almost every failure had one cause: a single accent colour was being used both as a fill and as text. It needed two values.</li>
        <li>Images are the weak point. A photo or illustration made for one palette can look like a mistake in another.</li>
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap stack" style="gap:28px">
      <h2 class="ds-display h2" data-reveal>The four systems</h2>
      {THEMES.map((t) => (
        <article class="specimen ds" data-system={t.id} data-reveal>
          <div class="specimen__head">
            <div><h3 class="ds-display">{t.name}</h3><p class="lede" style="margin-top:10px">{t.tagline}</p></div>
            <button type="button" class="ds-btn ds-btn--primary" data-system-id={t.id} data-wear={t.name} aria-pressed="false">Wear {t.name}</button>
          </div>
          <div class="specimen__cols">
            <div>
              <h4>Type</h4>
              <div class="specimen__aa ds-display">Aa</div>
              <p class="specimen__abc">{fontName(t.fonts.display)} for headings{fontName(t.fonts.body) !== fontName(t.fonts.display) ? `, ${fontName(t.fonts.body)} for text` : ' and text'}</p>
            </div>
            <div>
              <h4>Colour</h4>
              <div class="swatches">{swatchKeys.map((k) => <div><i style={`background:var(--ds-${kebab(k)})`}></i>{k}</div>)}</div>
            </div>
            <div>
              <h4>Shape</h4>
              <div class="row"><span class="ds-btn ds-btn--primary ds-btn--sm">Button</span><span class="ds-btn ds-btn--secondary ds-btn--sm">Button</span><span class="ds-badge ds-badge--1">Badge</span></div>
              <p class="specimen__abc">Buttons {t.shape.rBtn}, cards {t.shape.rCard}</p>
              <h4 style="margin-top:20px">Signature</h4>
              <p class="specimen__abc" style="margin:0">{signature[t.id]}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow stack" data-reveal>
      <h2 class="ds-display h2">Use the code</h2>
      <p class="lede">The component library behind this site is open source.</p>
      <div class="row">
        <a class="ds-btn ds-btn--primary" href="https://github.com/amberbockel/ui">View on GitHub</a>
        <a class="ds-btn ds-btn--secondary" href="https://amberbockel.github.io/ui/">Read the docs</a>
      </div>
    </div>
  </section>

  <Cta />
</Layout>
