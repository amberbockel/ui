---
import Layout from '../../layouts/Layout.astro';
import { sec, meta } from '../../lib.js';
import posts from '../../posts.json';
import config from '../../site.config.js';

const hero = sec('blog', 'Perspectives');
const [first, ...rest] = posts;
const fmt = (d) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout title="Blog | Amber Miro Heinbockel" description={meta('blog').description} current="/blog/">
  <section class="hero hero--plain">
    <div class="wrap stack center">
      <p class="eyebrow eyebrow--accent" data-rise style="--i:0">Blog</p>
      <h1 class="ds-display h1" data-rise style="--i:1">{hero.heading}</h1>
      <p class="lede" data-rise style="--i:2">What I’m learning at the intersection of design, AI, and human-centered decision-making.</p>
      <div class="row" data-rise style="--i:3"><a class="ds-btn ds-btn--primary" href={config.blog.substack + '/subscribe'}>Subscribe on Substack</a></div>
    </div>
  </section>

  <section class="section section--flush">
    <div class="wrap stack" style="gap:40px">
      <a class="post-feature" href={`/blog/${first.slug}/`} data-reveal>
        <div class="post-feature__media">{first.cover && <img src={first.cover} alt="" />}</div>
        <div class="stack" style="gap:12px">
          <time datetime={first.date}>Latest · {fmt(first.date)} · {first.minutes} min read</time>
          <h2 class="ds-display h2">{first.title}</h2>
          {first.summary && <p class="lede">{first.summary}</p>}
          <span class="arrow-link">Read the essay<span aria-hidden="true">→</span></span>
        </div>
      </a>
      <div class="post-grid">
        {rest.map((p, i) => (
          <a class="post-card" href={`/blog/${p.slug}/`} data-reveal style={`--d:${(i % 3) * 0.08}s`}>
            <div class="post-card__media">{p.cover && <img src={p.cover} alt="" loading="lazy" />}</div>
            <div class="post-card__body"><time datetime={p.date}>{fmt(p.date)} · {p.minutes} min read</time><h3 class="ds-display">{p.title}</h3>{p.summary && <p>{p.summary}</p>}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
