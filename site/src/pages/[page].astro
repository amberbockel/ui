---
import Layout from '../layouts/Layout.astro';
import Cta from '../components/Cta.astro';
import Testimonials from '../components/Testimonials.astro';
import content from '../content.json';

export function getStaticPaths() {
  return ['about', 'work', 'mentor', 'art', 'blog'].map((page) => ({ params: { page } }));
}
const { page } = Astro.params;
const data = content[page];
const [hero, ...rest] = data.sections.filter((x) => !x.heading.startsWith('Bringing clarity'));

// The live site animates these numbers, so only the labels could be read from it.
const STATS = { 'Design Leadership': '20+', 'Years in Big Tech': '10+', 'Mentorship minutes': '200k', 'Speaking Engagements': '45+' };
const STAT_LABELS = [...Object.keys(STATS), "Mentee's Served", 'of Projects & Counting'];
const isShort = (p) => p.split(' ').length <= 14 && !p.endsWith('.');
---
<Layout title={data.title} description={data.description} current={`/${page}/`}>
  <section class="hero">
    <div class="wrap stack">
      {hero.eyebrow && <p class="eyebrow">{hero.eyebrow}</p>}
      <h1 class="ds-display h1">{hero.heading}</h1>
      {hero.paras.map((p) => <p class="lede">{p}</p>)}
      {hero.links.length > 0 && <div class="row">{hero.links.map((l, i) => <a class={`ds-btn ${i ? 'ds-btn--secondary' : 'ds-btn--primary'}`} href={l.href}>{l.label}</a>)}</div>}
    </div>
  </section>

  {rest.map((sec, i) => {
    const paras = sec.paras.filter((p) => !STAT_LABELS.includes(p));
    const stats = sec.paras.filter((p) => STATS[p]);
    const bullets = paras.filter(isShort);
    const body = paras.filter((p) => !isShort(p));
    const img = sec.images[0];
    return (
      <section class="section">
        <div class="wrap stack" style="gap:28px">
          <div class={img && !sec.quotes ? `split ${i % 2 ? 'split--flip' : ''}` : 'stack'}>
            <div class="stack">
              {sec.eyebrow && <p class="eyebrow">{sec.eyebrow}</p>}
              <h2 class="ds-display h2">{sec.heading}</h2>
              {sec.labels && <div class="row">{sec.labels.map((l) => <span class="ds-badge ds-badge--outline">{l}</span>)}</div>}
              {body.length > 0 && <div class="prose">{body.map((p) => <p>{p}</p>)}</div>}
              {bullets.length > 0 && <ul class="list">{bullets.map((b) => <li>{b}</li>)}</ul>}
              {sec.links.length > 0 && <div class="row">{sec.links.map((l, j) => <a class={`ds-btn ds-btn--sm ${j ? 'ds-btn--secondary' : 'ds-btn--primary'}`} href={l.href}>{l.label}</a>)}</div>}
            </div>
            {img && !sec.quotes && <div class="split__media"><img src={img.src} alt={img.alt} loading="lazy" width={img.w} height={img.h} /></div>}
          </div>
          {stats.length > 0 && <div class="stats">{stats.map((l) => <div class="ds-card ds-stat"><b>{STATS[l]}</b><span>{l}</span></div>)}</div>}
          {sec.quotes && <Testimonials quotes={sec.quotes} />}
        </div>
      </section>
    );
  })}

  <Cta />
</Layout>
