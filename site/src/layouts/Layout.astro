---
import '../styles/components.css';
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import config from '../site.config.js';
import { THEMES, systemsCss } from '../systems.js';

const { title, description, current = '' } = Astro.props;
const nav = [['Home', '/'], ['About', '/about/'], ['Work', '/work/'], ['Mentor', '/mentor/'], ['Art', '/art/'], ['Blog', '/blog/']];
const ids = THEMES.map((t) => t.id);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" data-system={config.system}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Inter+Tight:wght@400;500;600;700&family=Prata&family=Sofia+Sans+Condensed:wght@400;500;600;700&family=Sofia+Sans+Extra+Condensed:wght@600;700;800&family=Wix+Madefor+Display:wght@400..800&display=swap" />
    <style is:inline set:html={systemsCss()}></style>
    <!-- Applies the saved system and mode before first paint, so there is no flash. -->
    <script is:inline define:vars={{ ids, allowSwitch: config.showSystemSwitch, fallback: config.system }}>
      (function () {
        var r = document.documentElement;
        if (!r.getAttribute('data-system')) r.setAttribute('data-system', fallback);
        try {
          var s = allowSwitch && localStorage.getItem('ab-system');
          if (s && ids.indexOf(s) > -1) r.setAttribute('data-system', s);
          var m = localStorage.getItem('ab-mode') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          r.setAttribute('data-mode', m);
        } catch (e) { r.setAttribute('data-mode', 'light'); }
      })();
    </script>
  </head>
  <body class="ds">
    <header class="site-head">
      <div class="wrap">
        <div class="ds-nav">
          <a class="logo" href="/" aria-label="Amber Bockel, home"><Logo /></a>
          <nav class="ds-nav__links" aria-label="Main">
            {nav.map(([label, href]) => <a class="ds-navlink" href={href} aria-current={current === href ? 'page' : undefined}>{label}</a>)}
          </nav>
          <div class="ds-nav__tools">
            <button class="ds-iconbtn" id="mode-toggle" aria-label="Switch between light and dark">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            </button>
            <a class="ds-btn ds-btn--primary ds-btn--sm" href="mailto:amberbockel+website@gmail.com">Say hello</a>
          </div>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-foot">
      <div class="wrap">
        <div class="site-foot__top">
          <div class="stack">
            <p class="ds-display h3">I help organizations design how humans and AI make decisions together.</p>
            <p class="ds-muted" style="margin:0">If you’re looking for guidance, clarity, or a little color for your walls, I’m your person.</p>
            <div><a class="ds-btn ds-btn--secondary" href="mailto:amberbockel+website@gmail.com">Say hello</a></div>
          </div>
          <nav aria-label="Footer">{nav.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
        </div>
        <div class="site-foot__bottom">
          <span>© {year} Amber Miro Creative. All rights reserved</span>
          {config.showSystemSwitch && (
            <div class="sys-switch" role="group" aria-label="Design system">
              <span>System</span>
              {THEMES.map((t) => <button type="button" data-system-id={t.id} aria-pressed="false">{t.name}</button>)}
            </div>
          )}
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var r = document.documentElement;
        function save(k, v) { try { localStorage.setItem(k, v); } catch (e) {} }
        function paint() {
          var b = document.querySelectorAll('[data-system-id]');
          for (var i = 0; i < b.length; i++) b[i].setAttribute('aria-pressed', String(b[i].getAttribute('data-system-id') === r.getAttribute('data-system')));
        }
        document.getElementById('mode-toggle').addEventListener('click', function () {
          var m = r.getAttribute('data-mode') === 'dark' ? 'light' : 'dark';
          r.setAttribute('data-mode', m); save('ab-mode', m);
        });
        document.addEventListener('click', function (e) {
          var b = e.target.closest('[data-system-id]'); if (!b) return;
          r.setAttribute('data-system', b.getAttribute('data-system-id')); save('ab-system', b.getAttribute('data-system-id')); paint();
        });
        paint();
      })();
    </script>
  </body>
</html>
